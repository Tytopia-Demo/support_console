# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-journal

# Ignore all logfiles and tempfiles.
/log/*
!/log/.keep
/tmp

# Ignore compiled assets (Sprockets asset pipeline).
/public/assets

# Ignore Ruby compiled files.
*.rbc

# Ignore Byebug debugger history.
.byebug_history

# Ignore environment variable files.
.env
.env.*
!.env.example

# Ignore Rails master key (credentials encryption key).
/config/master.key

# Ignore Node.js dependencies.
node_modules/

# Ignore Yarn error log.
yarn-error.log

# Ignore Capybara test artifacts.
capybara-*.html
/tmp/capybara
